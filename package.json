{
  "name": "pushgo-from-text",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first campus article drafting and editable rich-text export",
  "type": "module",
  "engines": { "node": ">=22.3.0" },
  "scripts": {
    "pushgo": "tsx src/cli/index.ts",
    "skill:install": "node scripts/install_writer_skill.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "docx": "9.12.0",
    "mammoth": "1.13.0",
    "pdfjs-dist": "5.4.624",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
